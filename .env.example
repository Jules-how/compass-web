# Supabase project credentials.
# Find these in your Supabase project: Settings > API.
# Cloud Agents also need the same values as Cursor Cloud Secrets
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) —
# see memory/reference/cloud-secrets-checklist.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used only by the operator-authorized invitation sender; customer
# and legacy data routes remain cookie/session-bound and RLS-enforced.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORTAL_RATE_LIMIT_SALT=replace-with-a-random-server-only-value

# Reversible rollout flag. Leave unset/0 until live tenant-isolation tests pass.
COMPASS_PORTAL_V1=0

# Open operator console without a login screen (default on).
# Set COMPASS_OPEN_OPERATOR=0 to restore password login.
COMPASS_OPEN_OPERATOR=1
COMPASS_OPEN_OPERATOR_EMAIL=
COMPASS_OPEN_OPERATOR_PASSWORD=

# Shared secret for POST /api/ingest/leads (x-ingest-secret). Server-only.
COMPASS_LEAD_INGEST_SECRET=

# After Vercel deploy, add to Supabase Auth → Redirect URLs:
#   http://localhost:3100/auth/callback
#   https://<your-vercel-domain>/auth/callback
