# Supabase project credentials.
# Find these in your Supabase project: Settings > API.
# Cloud Agents also need the same values as Cursor Cloud Secrets
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY) —
# see memory/reference/cloud-secrets-checklist.md.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used only by the operator-authorized invitation sender; customer
# and legacy data routes remain cookie/session-bound and RLS-enforced.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORTAL_RATE_LIMIT_SALT=replace-with-a-random-server-only-value

# Reversible rollout flag. Leave unset/0 until live tenant-isolation tests pass.
COMPASS_PORTAL_V1=0

# Open operator console without a login screen (default on).
# Set COMPASS_OPEN_OPERATOR=0 to restore password login.
COMPASS_OPEN_OPERATOR=1
COMPASS_OPEN_OPERATOR_EMAIL=
COMPASS_OPEN_OPERATOR_PASSWORD=

# Shared secret for POST /api/ingest/leads (x-ingest-secret). Server-only.
COMPASS_LEAD_INGEST_SECRET=

# Optional dedicated secret for POST /api/ingest/comms (falls back to lead secret).
# COMPASS_COMMS_INGEST_SECRET=

# Cursor local/cloud agents → Compass bridge (/api/agent/*).
# Also used as fallback auth for /api/cron/daily-sync when CRON_SECRET is unset.
# Set the same value as a Cloud Agent / Cursor secret named COMPASS_AGENT_SECRET.
COMPASS_AGENT_SECRET=
# Optional public base URL agents should call (production Vercel host or localhost:3100).
# COMPASS_BASE_URL=https://your-app.vercel.app
# Vercel Cron Authorization: Bearer <CRON_SECRET> (auto-injected on Vercel when set).
# CRON_SECRET=

# Brain Dump AI (Vercel AI Gateway). Optional — without credentials the Home
# button falls back to a fast local heuristic. Also powers client Comms summaries.
# Prefer AI_GATEWAY_API_KEY locally, or `vercel env pull` for VERCEL_OIDC_TOKEN.
# On Vercel, OIDC works automatically once AI Gateway is enabled for the project.
AI_GATEWAY_API_KEY=
# COMPASS_AI_ENABLED=0
# COMPASS_AI_MODEL=openai/gpt-5.4-nano

# Instantly.ai (Home cold-email glance). Server-only Bearer API key.
# Create at Instantly → Settings → Integrations → API.
# Prefer Vercel env; Compass Settings can also store the key in compass_settings.
INSTANTLY_API_KEY=
# Optional IANA timezone for "today" / rolling windows (default Australia/Melbourne).
# INSTANTLY_TIMEZONE=Australia/Melbourne

# Ad account connections (Settings → Ad accounts).
# Tokens are encrypted at rest; set an explicit key in production (32-byte hex or passphrase).
AD_TOKEN_ENCRYPTION_KEY=
# Assumed $ value per lead when purchase ROAS is unavailable (lead-gen accounts).
AD_DEFAULT_LEAD_VALUE=200
# Optional Meta OAuth (Facebook Login for Business). Redirect:
#   https://<host>/api/ads/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
# Optional Google Ads API developer token (can also be pasted per-account in Settings).
GOOGLE_ADS_DEVELOPER_TOKEN=

# After Vercel deploy, add to Supabase Auth → Redirect URLs:
#   http://localhost:3100/auth/callback
#   https://<your-vercel-domain>/auth/callback
